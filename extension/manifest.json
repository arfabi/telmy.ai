{
  "manifest_version": 3,
  "name": "Telmy.ai: Your AI Form Filling Assistant",
  "version": "1.0.0",
  "description": "Your AI Form Filling Assistant to help you understand and complete web forms with ease.",
  "minimum_chrome_version": "114",
  "icons": {
    "16": "assets/icons/icon16.png",
    "32": "assets/icons/icon32.png",
    "48": "assets/icons/icon48.png",
    "128": "assets/icons/icon128.png"
  },
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "sidePanel"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_icon": {
      "16": "assets/icons/icon16.png",
      "48": "assets/icons/icon48.png"
    },
    "default_title": "Buka Telmy.ai Side Panel"
  },
  "side_panel": {
    "default_path": "sidepanel/sidepanel.html"
  },
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+G"
      },
      "description": "Buka Telmy.ai Side Panel"
    }
  },
  "externally_connectable": {
    "matches": [
      "https://telmy.id/*",
      "https://telmyai.com/*",
      "http://localhost/*",
      "http://127.0.0.1/*"
    ]
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "all_frames": false,
      "js": [
        "content/scanner.js",
        "content/highlighter.js",
        "content/translator.js",
        "content/content-main.js"
      ],
      "css": [
        "content/overlay.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "mock/*",
        "assets/*",
        "assets/icons/*"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}
