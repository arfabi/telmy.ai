# Port for server (default 8080 for Cloud Run compatibility)
PORT=8080

# Environment: development / production
NODE_ENV=development

# AI Provider: 'openai' (primary) or 'gemini' (secondary)
AI_PROVIDER=openai

# OpenAI-Compatible API Configuration (OpenAI, Groq, OpenRouter, DeepSeek, Ollama, etc.)
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=your_openai_or_compatible_key_here
OPENAI_MODEL=gpt-4o-mini

# Gemini AI Configuration (Paling Hemat Biaya & Latensi Kilat)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite

# Google Cloud Text-to-Speech (WaveNet Voices - 4M Karakter/Bulan Free Tier)
GOOGLE_TTS_API_KEY=your_google_cloud_tts_api_key_here

# Firebase Admin SDK Configuration (Firestore, Storage, Auth)
GOOGLE_APPLICATION_CREDENTIALS=./serviceAccountKey.json
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_STORAGE_BUCKET=your-firebase-project-id.appspot.com

# Optional OpenAI-Compatible Fallback
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
