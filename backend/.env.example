# Port for server (default 8080 for Cloud Run compatibility)
PORT=8080

# Environment: development / production
NODE_ENV=development

# AI Provider: 100% Google Gemini (Google AI Native)
AI_PROVIDER=gemini

# Resolution Mode: 'AI_FIRST' (Call AI first, save to DB) or 'DB_FIRST' (Check Firestore first, then AI)
EXPLAIN_STRATEGY=AI_FIRST

# Gemini AI Configuration (Google AI Native)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite

# Google Cloud Text-to-Speech (WaveNet Voices)
GOOGLE_TTS_API_KEY=your_google_cloud_tts_api_key_here
GOOGLE_TTS_ENDPOINT=https://texttospeech.googleapis.com/v1/text:synthesize
GOOGLE_TTS_MODEL_NAME=Google Cloud TTS WaveNet

# Firebase Admin SDK Configuration (Firestore, Storage, Auth)
GOOGLE_APPLICATION_CREDENTIALS=./serviceAccountKey.json
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_STORAGE_BUCKET=your-firebase-project-id.appspot.com
