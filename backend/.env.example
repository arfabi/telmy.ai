# ==============================================================================
# TELMY.AI — BACKEND ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ==============================================================================
# Petunjuk:
# 1. Salin file ini menjadi .env: cp .env.example .env (atau copy di Windows)
# 2. Isi nilai API key dan konfigurasi project Anda di bawah ini.
# 3. File .env bersifat privat dan sudah diabaikan oleh .gitignore (jangan di-commit).
# ==============================================================================

# --- 1. SERVER CONFIGURATION ---
# Port server backend (8080 adalah default untuk Google Cloud Run & local dev)
PORT=8080

# Environment: 'development' atau 'production'
NODE_ENV=development

# --- 2. GOOGLE GEMINI AI CONFIGURATION (Wajib untuk AI Reasoning) ---
# Dapatkan API Key gratis di Google AI Studio: https://aistudio.google.com/
AI_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite

# Strategi penalaran:
# 'AI_FIRST' = Panggil AI terlebih dahulu lalu simpan ke Firestore
# 'DB_FIRST' = Cek cache Firestore terlebih dahulu, jika belum ada panggil AI
EXPLAIN_STRATEGY=AI_FIRST

# --- 3. GOOGLE CLOUD TEXT-TO-SPEECH (Opsional: Voice WaveNet) ---
# Jika kosong, ekstensi akan otomatis fallback menggunakan Web Speech API browser
GOOGLE_TTS_API_KEY=your_google_cloud_tts_api_key_here
GOOGLE_TTS_ENDPOINT=https://texttospeech.googleapis.com/v1/text:synthesize
GOOGLE_TTS_MODEL_NAME=Google Cloud TTS WaveNet
GOOGLE_TTS_REFERER=https://telmy-ai.cloud.run/

# --- 4. FIREBASE ADMIN SDK (Backend: Firestore, Auth, Storage) ---
# Opsi A (Lokal): Letakkan serviceAccountKey.json di folder backend/
# Opsi B (Cloud Run / GCP): Kosongkan kredensial di bawah jika menggunakan Google Cloud ADC
GOOGLE_APPLICATION_CREDENTIALS=./serviceAccountKey.json
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_STORAGE_BUCKET=your-firebase-project-id.firebasestorage.app

# --- 5. FIREBASE CLIENT WEB SDK (Frontend: connect.html & dashboard.html) ---
# Diambil dari Firebase Console > Project Settings > General > Your apps (Web App)
# Nilai ini disajikan secara dinamis lewat endpoint /firebase-config.js
FIREBASE_WEB_API_KEY=your_firebase_web_api_key
FIREBASE_AUTH_DOMAIN=your-firebase-project-id.firebaseapp.com
FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
FIREBASE_APP_ID=your_firebase_web_app_id

# --- 6. PAYMENT GATEWAY / LEMON SQUEEZY (Opsional: Simulasi aktif secara default) ---
# Jika dibiarkan kosong, sistem otomatis berjalan dalam Mode Simulasi (Free Sandbox Testing)
LEMON_SQUEEZY_API_KEY=
LEMON_SQUEEZY_STORE_ID=
LEMON_SQUEEZY_VARIANT_STARTER=
LEMON_SQUEEZY_VARIANT_PRO=
